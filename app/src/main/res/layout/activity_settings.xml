<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textColor="@color/cyan"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endpoint URL"
            android:textSize="14sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/settingsEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.openai.com/v1"
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_dim"
            android:background="@drawable/glass_input"
            android:padding="12dp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textSize="14sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/settingsApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_dim"
            android:background="@drawable/glass_input"
            android:padding="12dp"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model"
            android:textSize="14sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/settingsModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="gpt-4o-mini"
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_dim"
            android:background="@drawable/glass_input"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <CheckBox
            android:id="@+id/settingsVoiceOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice output (read replies aloud)"
            android:textSize="16sp"
            android:textColor="@color/text_light"
            android:buttonTint="@color/cyan"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/settingsPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OmniRoute Preset"
            android:textColor="@color/void_black"
            android:backgroundTint="@color/gold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/settingsSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE"
            android:textColor="@color/void_black"
            android:backgroundTint="@color/cyan" />

    </LinearLayout>
</ScrollView>
