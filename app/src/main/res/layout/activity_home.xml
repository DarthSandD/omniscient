<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="At your service, boss."
            android:textSize="28sp"
            android:textColor="@color/cyan"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/homeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type your order, boss…"
            android:textSize="16sp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_dim"
            android:background="@drawable/glass_input"
            android:padding="16dp"
            android:layout_marginTop="32dp"
            android:inputType="text"
            android:maxLines="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/homeSend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEND"
                android:textColor="@color/void_black"
                android:backgroundTint="@color/cyan" />

            <ImageButton
                android:id="@+id/homeVoice"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/mic_ring"
                android:contentDescription="Voice input" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigate"
            android:textSize="14sp"
            android:textColor="@color/gold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/navChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat Session"
                android:textColor="@color/cyan"
                android:backgroundTint="@color/glass_bg"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/navHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conversation History"
                android:textColor="@color/cyan"
                android:backgroundTint="@color/glass_bg"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/navTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminal Log"
                android:textColor="@color/cyan"
                android:backgroundTint="@color/glass_bg"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/cyan"
                android:backgroundTint="@color/glass_bg" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
