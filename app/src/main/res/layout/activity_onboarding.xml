<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/onboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omniscient"
            android:textSize="48sp"
            android:textColor="@color/cyan"
            android:textStyle="bold"
            android:layout_marginTop="48dp" />

        <TextView
            android:id="@+id/onboardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your AI Butler"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/onboardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, boss. I'm Omniscient — part Jarvis, part Alfred, all yours.\n\nI can:\n• Control your phone (flashlight, Wi-Fi, Bluetooth, apps)\n• Set alarms and timers\n• Make calls and send SMS (with your permission)\n• Read notifications\n• Remember your preferences\n• Search the web\n• And much more\n\nJust type or speak your orders. I'll handle the rest.\n\nTap BEGIN when you're ready."
            android:textSize="16sp"
            android:textColor="@color/text_light"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="32dp" />

        <Button
            android:id="@+id/beginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BEGIN"
            android:textSize="18sp"
            android:textColor="@color/void_black"
            android:backgroundTint="@color/cyan"
            android:layout_marginTop="48dp" />

    </LinearLayout>
</ScrollView>
