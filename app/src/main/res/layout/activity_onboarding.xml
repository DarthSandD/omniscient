<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/HudHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/tagline" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/glass_assistant"
            android:gravity="center"
            android:padding="24dp"
            android:text=""
            android:textColor="@color/ghost_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/howText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/terminal_bg"
            android:padding="20dp"
            android:text=""
            android:textColor="@color/terminal_green"
            android:textSize="13sp" />

        <Button
            android:id="@+id/presetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="USE OMNIROUTE PRESET (HOUSE LAN)" />

        <Button
            android:id="@+id/beginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="BEGIN SERVICE" />

        <TextView
            android:id="@+id/onboardNote"
            style="@style/HudStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="" />
    </LinearLayout>
</ScrollView>
