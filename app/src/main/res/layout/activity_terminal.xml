<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/HudHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C O M M A N D   T E R M I N A L" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Every tool call, as it happens."
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/terminal_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/terminalLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— terminal clear. Give an order and watch the work, boss. —"
            android:textColor="@color/terminal_green"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="CLEAR" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="BACK" />
    </LinearLayout>
</LinearLayout>
